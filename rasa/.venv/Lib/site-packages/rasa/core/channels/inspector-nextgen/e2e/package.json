{
  "name": "inspector-e2e",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "e2e:setup": "bash scripts/e2e-setup.sh",
    "e2e": "start-server-and-test \"bash scripts/e2e-setup.sh\" http-get://localhost:5005 e2e:only",
    "e2e:only": "playwright test --reporter=html --workers=4",
    "e2e:watch": "playwright test --headed --reporter=html --workers=1",
    "e2e:trace": "playwright test --ui --reporter=html",
    "e2e:debug": "playwright test --debug --reporter=html --workers=1",
    "e2e:repeat": "playwright test --repeat-each=10 --workers=4",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/node": "24.13.2",
    "dd-trace": "5.108.0",
    "start-server-and-test": "2.1.5"
  }
}
