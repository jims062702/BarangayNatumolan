# Resident portal accounts are activated by a code EMAILED to the resident,
# so mail must actually send — "log" only writes to storage/logs/laravel.log.
#
# Gmail SMTP. Two things are NOT optional:
#
#   1. MAIL_PASSWORD is a 16-character APP PASSWORD, never the Google account
#      password, and app passwords only exist once 2-Step Verification is on:
#      myaccount.google.com/security -> 2-Step Verification -> App passwords.
#      Paste it without the spaces Google shows it in.
#   2. MAIL_FROM_ADDRESS must be the SAME mailbox as MAIL_USERNAME. Gmail
#      rewrites a From it does not own, so a mismatch either bounces or
#      arrives from the wrong address.
#
# Port 587 with STARTTLS is what Gmail wants; MAIL_SCHEME stays empty for it
# (set it to "smtps" only if you switch to port 465).
#
# Run `php artisan mail:test you@example.com` after filling these in — it
# names what is wrong instead of failing silently.
#Barangay Natumolan OTP
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=gasang143x@gmail.com
MAIL_PASSWORD=mfolzsjyyhthhxxu
MAIL_FROM_ADDRESS=gasang143x@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
